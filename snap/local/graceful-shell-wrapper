#!/bin/sh
# Launcher for the classic snap.
#
# `make install-portal` registers the shell as the ScreenCast portal backend by
# writing into XDG_DATA_HOME / XDG_CONFIG_HOME. A snap cannot do that at build
# time — those paths belong to the user, not the package — so the equivalent
# happens here on first run. Classic confinement means $HOME is the real home,
# so an ordinary copy is all it takes.
set -eu

real_home="${SNAP_REAL_HOME:-$HOME}"
data_home="${XDG_DATA_HOME:-$real_home/.local/share}"
config_home="${XDG_CONFIG_HOME:-$real_home/.config}"

portal_src="$SNAP/share/graceful-shell/portal"
portal_dst="$data_home/xdg-desktop-portal/portals/graceful-shell.portal"
conf_dst="$config_home/xdg-desktop-portal/mir-portals.conf"

installed_something=

# Never overwrite. The .conf carries the user's backend preference and the
# .portal may have been placed by `make install-portal` from a source build —
# same rule the Makefile follows.
if [ ! -e "$portal_dst" ] && [ -r "$portal_src/graceful-shell.portal" ]; then
  mkdir -p "$(dirname "$portal_dst")"
  cp "$portal_src/graceful-shell.portal" "$portal_dst"
  installed_something=1
fi

if [ ! -e "$conf_dst" ] && [ -r "$portal_src/graceful-shell-portals.conf" ]; then
  mkdir -p "$(dirname "$conf_dst")"
  cp "$portal_src/graceful-shell-portals.conf" "$conf_dst"
  installed_something=1
fi

if [ -n "$installed_something" ]; then
  # xdg-desktop-portal only reads these at start-up, so screen sharing will not
  # route here until it is restarted.
  echo "graceful-shell: registered the ScreenCast portal backend." >&2
  echo "graceful-shell: run 'systemctl --user restart xdg-desktop-portal'" >&2
  echo "graceful-shell: to enable screen sharing." >&2
fi

exec "$SNAP/graceful_shell" "$@"
