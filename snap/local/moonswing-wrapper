#!/bin/sh
# Launcher for the classic snap.
#
# The install hook registers the ScreenCast portal backend machine-wide, under
# /usr/share (see snap/local/portal-setup). That is the lowest-precedence
# location xdg-desktop-portal searches, so it is a *default*, not an override —
# a user who already has ~/.config/xdg-desktop-portal/portals.conf naming
# another backend would never reach it. Only a per-user, desktop-specific file
# out-ranks that, and a root hook has no SNAP_REAL_HOME and no idea whose
# session it is registering for. So the per-user half happens here, on first
# run, exactly as `make install-portal` does it for a source build.
#
# The second half of the job is the restart: xdg-desktop-portal reads all of
# this once, at start-up. This used to print instructions telling the user to
# do it; now it is done for them.
#
# Classic confinement means $HOME is the real home, so an ordinary copy is all
# it takes.
set -eu

real_home="${SNAP_REAL_HOME:-$HOME}"
data_home="${XDG_DATA_HOME:-$real_home/.local/share}"
config_home="${XDG_CONFIG_HOME:-$real_home/.config}"
state_dir="${SNAP_USER_COMMON:-$real_home/snap/moonswing/common}"

portal_src="$SNAP/share/moonswing/portal"
portal_dst="$data_home/xdg-desktop-portal/portals/moonswing.portal"
xdp_conf_dir="$config_home/xdg-desktop-portal"

# XDG_CURRENT_DESKTOP under miracle-wm is "miracle-wm:mir", and
# xdg-desktop-portal consults <desktop>-portals.conf for each name in that list
# before the generic portals.conf beside it. Which of the two is reached first
# depends on an ordering the shell does not control, so write both.
conf_names='miracle-wm-portals.conf mir-portals.conf'

# What this snap created, for the remove hook to undo. Paths only; the hook
# filters it down to .portal files, because a *-portals.conf may have been
# edited by the user afterwards.
manifest="$state_dir/portal-installed"
# The revision the portal files were last (re)registered for. A refresh can
# change what is shipped, so the restart below is once per revision, not once
# ever.
stamp="$state_dir/portal-stamp"

note() { echo "moonswing: $*" >&2; }

# `[screenshare] enabled = false` in config.toml means the shell will not serve
# ScreenCast (lib/screencast/screencast_service.dart). Registering it
# anyway would point xdg-desktop-portal at a bus name nobody owns, which breaks
# ScreenCast outright instead of leaving it with whatever the user chose. No
# TOML parser in a POSIX shell, so read the one table: unreadable or absent
# means the default, which is enabled. InputCapture rides on the same files, so
# opting out of screen sharing here stops the snap registering either; the line
# for it can still be added to a conf by hand.
screenshare_enabled() {
  cfg="$config_home/moonswing/config.toml"
  [ -r "$cfg" ] || return 0
  sed -n '/^[[:space:]]*\[screenshare\]/,/^[[:space:]]*\[/{ /^[[:space:]]*\[/d; p; }' \
    "$cfg" 2>/dev/null |
    grep -qE '^[[:space:]]*enabled[[:space:]]*=[[:space:]]*false' && return 1
  return 0
}

# Confs this snap wrote before the shell served InputCapture route ScreenCast
# alone, and a per-user conf out-ranks the machine default that now names both
# — so without this, an existing install would never route input capture to the
# shell. Narrow on purpose: only a file the manifest says this snap created
# (never one the user or `make install-portal` wrote), and only when it says
# nothing about InputCapture at all; a line naming any backend for it is a
# choice, and stays.
prefer_input_capture() {
  for name in $conf_names; do
    f="$xdp_conf_dir/$name"
    [ -w "$f" ] || continue
    grep -qxF "$f" "$manifest" 2>/dev/null || continue
    grep -qE '^[[:space:]]*org\.freedesktop\.impl\.portal\.InputCapture[[:space:]]*=' \
      "$f" 2>/dev/null && continue
    grep -qE '^[[:space:]]*\[preferred\]' "$f" 2>/dev/null || continue
    sed -i '/^[[:space:]]*\[preferred\][[:space:]]*$/a org.freedesktop.impl.portal.InputCapture=moonswing' \
      "$f" 2>/dev/null || true
  done
}

# A -portals.conf that already routes ScreenCast somewhere else is the user's
# stated preference and is never edited or out-ranked — but it is also the one
# thing that silently defeats all of the above, so say so.
conflicting_conf() {
  for name in $conf_names; do
    f="$xdp_conf_dir/$name"
    [ -r "$f" ] || continue
    line=$(grep -E '^[[:space:]]*org\.freedesktop\.impl\.portal\.ScreenCast[[:space:]]*=' \
      "$f" 2>/dev/null | tail -n 1) || true
    [ -n "$line" ] || continue
    case "$line" in
      *moonswing*) continue ;;
      *) echo "$f"; return 0 ;;
    esac
  done
  return 1
}

record() {
  mkdir -p "$state_dir"
  grep -qxF "$1" "$manifest" 2>/dev/null || echo "$1" >>"$manifest"
}

# Never overwrite. The .conf carries the user's backend preference and the
# .portal may have been placed by `make install-portal` from a source build —
# same rule the Makefile follows.
install_absent() { # <src> <dst>
  if [ -e "$2" ] || [ ! -r "$1" ]; then
    return 1
  fi
  mkdir -p "$(dirname "$2")"
  cp "$1" "$2"
  record "$2"
  return 0
}

register_portal() {
  screenshare_enabled || {
    note "screen sharing disabled in config.toml; not registering the portal."
    return 0
  }

  install_absent "$portal_src/moonswing.portal" "$portal_dst" || true

  if conflict=$(conflicting_conf); then
    note "$conflict already routes ScreenCast elsewhere; leaving it alone."
    note "to use the shell's picker, set in that file:"
    note "  org.freedesktop.impl.portal.ScreenCast=moonswing"
  else
    for name in $conf_names; do
      install_absent "$portal_src/moonswing-portals.conf" \
        "$xdp_conf_dir/$name" || true
    done
    prefer_input_capture
  fi

  # xdg-desktop-portal only reads the .portal files and the preferences at
  # start-up. try-restart, not restart: it is a no-op when the service is not
  # running, so a session with no systemd user instance — or one where nothing
  # has activated the portal yet — is not forced to start it. Nothing is
  # sharing the screen at shell start-up, so this is safe here and nowhere
  # later. Only the frontend; the backends are not ours to bounce.
  #
  # This restart necessarily happens *before* the exec below, so the frontend
  # it brings up reads a backend bus name nobody owns yet and caches "no
  # capture sources" — which is invisible to an app that just shares and fatal
  # to one that asks first (OBS). A wrapper cannot fix its own ordering; the
  # shell does, once it owns the name, from
  # lib/screencast/portal_frontend.dart. This half stays because that half
  # cannot replace it: it is the newly written *config* that needs re-reading
  # here, and a frontend still routed to a working xdg-desktop-portal-wlr
  # answers with wlr's source types rather than the zero the shell repairs.
  if systemctl --user try-restart xdg-desktop-portal.service 2>/dev/null; then
    :
  else
    note "could not restart xdg-desktop-portal; screen sharing may need"
    note "  systemctl --user restart xdg-desktop-portal"
  fi

  mkdir -p "$state_dir"
  echo "${SNAP_REVISION:-unknown}" >"$stamp"
}

if [ "$(cat "$stamp" 2>/dev/null || true)" != "${SNAP_REVISION:-unknown}" ]; then
  register_portal
fi

# gdk-pixbuf's loaders must be the ones built against the gdk-pixbuf the shell
# actually loads, which is the staged one: LD_LIBRARY_PATH puts it ahead of the
# host's. With no GDK_PIXBUF_MODULE_FILE, though, it reads the *host's*
# loaders.cache — a path compiled into it — and so loads the host's loader
# modules, whose own dependencies then resolve to whatever is staged. The SVG
# loader is the one that breaks: librsvg 2.59+ ships it calling
# rsvg_handle_get_pixbuf_and_error, which core22's staged librsvg-2.so.2 does
# not have, and GTK aborts on the first themed icon it draws ("Unable to load
# image-loading module ... undefined symbol"). So the shell gets a cache of the
# staged loaders, svg included (librsvg2-common is staged for it), generated
# here because the paths in it are absolute and $SNAP moves every revision.
#
# The variable is inherited by everything the shell starts, which is all the
# host's; lib/host_process.dart takes it back off for them, as it does the
# staged LD_LIBRARY_PATH entries. A failed generation exports nothing and leaves
# the shell as it was rather than with no loaders at all.
pixbuf_dir="$SNAP/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0"
pixbuf_cache="$state_dir/gdk-pixbuf-loaders.cache"
if mkdir -p "$state_dir" 2>/dev/null &&
  "$pixbuf_dir/gdk-pixbuf-query-loaders" "$pixbuf_dir"/2.10.0/loaders/*.so \
    >"$pixbuf_cache.$$" 2>/dev/null &&
  mv -f "$pixbuf_cache.$$" "$pixbuf_cache"; then
  export GDK_PIXBUF_MODULE_FILE="$pixbuf_cache"
else
  rm -f "$pixbuf_cache.$$" 2>/dev/null || true
  note "could not index the bundled image loaders; icons may fail to load."
fi

exec "$SNAP/moonswing" "$@"
