@@ -887,6 +887,20 @@ mixin class PopupWindowControllerDelegate {
   void onWindowDestroyed() {
     if (!isWindowingEnabled) {
       throw UnsupportedError(_kWindowingDisabledErrorMessage);
     }
   }
+
+  /// Invoked when the compositor has dismissed the popup — typically because
+  /// the user clicked outside it, including on another application's window.
+  ///
+  /// The popup's surface is already off screen by the time this runs, but the
+  /// controller is still valid and its view is still live. The owner is
+  /// expected to call [PopupWindowController.destroy], on its own schedule and
+  /// once the framework has released the view; destroying a window whose view
+  /// is still attached is not safe.
+  ///
+  /// {@macro flutter.widgets.windowing.experimental}
+  @internal
+  void onWindowDismissed() {
+    if (!isWindowingEnabled) {
+      throw UnsupportedError(_kWindowingDisabledErrorMessage);
+    }
+  }
 }
