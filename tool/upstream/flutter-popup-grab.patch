+/// Wraps GdkSeat.
+class _GdkSeat extends _GObject {
+  /// Creates a wrapper to an existing [GdkSeat] in [instance].
+  const _GdkSeat(super.instance);
+
+  /// Grabs the seat's devices for [window], showing it from [prepare].
+  ///
+  /// [prepare] must make [window] visible: GDK records the seat on the window,
+  /// calls [prepare], then refuses the grab and clears the seat again if the
+  /// window is still not visible. Showing it there is also what makes the map
+  /// — and so the `xdg_popup` GDK creates from it — carry the grab.
+  _GdkGrabStatus grab(
+    _GdkWindow window, {
+    int capabilities = _GdkSeatCapabilities.all,
+    bool ownerEvents = true,
+    required VoidCallback prepare,
+  }) {
+    // GDK invokes this synchronously, on this thread, from inside the call
+    // below, and does not retain it afterwards.
+    final callable = ffi.NativeCallable<_GdkSeatGrabPrepareFuncNative>.isolateLocal(
+      (ffi.Pointer<ffi.NativeType> _, ffi.Pointer<ffi.NativeType> __, ffi.Pointer<ffi.NativeType> ___) =>
+          prepare(),
+    );
+    try {
+      final int status = _gdkSeatGrab(
+        instance,
+        window.instance,
+        capabilities,
+        ownerEvents ? 1 : 0,
+        ffi.nullptr,
+        ffi.nullptr,
+        callable.nativeFunction.cast(),
+        ffi.nullptr,
+      );
+      return status >= 0 && status < _GdkGrabStatus.values.length
+          ? _GdkGrabStatus.values[status]
+          : _GdkGrabStatus.failed;
+    } finally {
+      callable.close();
+    }
+  }
+
+  /// Releases whatever this seat is grabbing.
+  void ungrab() => _gdkSeatUngrab(instance);
+
+  // `gboolean` is `gint`, so ffi.Int rather than ffi.Bool.
+  @ffi.Native<
+    ffi.Int Function(
+      ffi.Pointer<ffi.NativeType>,
+      ffi.Pointer<ffi.NativeType>,
+      ffi.Uint32,
+      ffi.Int,
+      ffi.Pointer<ffi.NativeType>,
+      ffi.Pointer<ffi.NativeType>,
+      ffi.Pointer<ffi.NativeType>,
+      ffi.Pointer<ffi.NativeType>,
+    )
+  >(symbol: 'gdk_seat_grab')
+  external static int _gdkSeatGrab(
+    ffi.Pointer<ffi.NativeType> seat,
+    ffi.Pointer<ffi.NativeType> window,
+    int capabilities,
+    int ownerEvents,
+    ffi.Pointer<ffi.NativeType> cursor,
+    ffi.Pointer<ffi.NativeType> event,
+    ffi.Pointer<ffi.NativeType> prepareFunc,
+    ffi.Pointer<ffi.NativeType> prepareFuncData,
+  );
+
+  @ffi.Native<ffi.Void Function(ffi.Pointer<ffi.NativeType>)>(symbol: 'gdk_seat_ungrab')
+  external static void _gdkSeatUngrab(ffi.Pointer<ffi.NativeType> seat);
